{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deltronixinternational",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deltronix-leads",
      "database_id": "a4530ae3-18d1-46d0-9c59-917c8eabab1c"
    }
  ]
  // Optional secrets (Workers > Settings > Variables and Secrets):
  //   ADMIN_PASSWORD    -> protects /admin (CRM) and /api/admin/* with a browser login (user: admin)
  //   ADMIN_TOKEN       -> enables GET /api/leads.csv?token=... (lead export)
  //   LEAD_WEBHOOK_URL  -> each new lead is POSTed as JSON (Zapier, Make, n8n, Slack, CRM...)
}
